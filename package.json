{
  "name": "litt31",
  "version": "0.0.1",
  "description": "Automation Engineering",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "run-p server watch",
    "deploy": "run-s build:prod release",
    "prehtml": "js-yaml src/content.yml > dist/content.json",
    "html": "pug -O dist/content.json -P src/index.pug src/alfr3d.pug src/lab.pug src/timeline.pug src/privacy.pug src/honesty.pug -o dist",
    "posthtml": "rimraf dist/content.json",
    "css": "stylus src/css/index.styl --include node_modules --include-css --print | postcss -o dist/css/style.css --config conf",
    "js:dev": "browserify src/js/index.js -o dist/js/main.js -d -t [ babelify --presets [ @babel/preset-env ] ]",
    "js:prod": "browserify src/js/index.js -o dist/js/main.js -t [ babelify --presets [ @babel/preset-env ] ]",
    "clean": "rimraf dist",
    "mkdirs": "mkdirp dist/assets dist/js dist/css",
    "copy:assets": "cpr src/assets dist/assets",
    "copy:cname": "cp CNAME dist/CNAME",
    "prebuild:dev": "run-s clean mkdirs copy:*",
    "build:dev": "run-p html css js:dev",
    "prebuild:prod": "run-s clean mkdirs copy:*",
    "build:prod": "cross-env NODE_ENV=prod run-p html css js:prod",
    "postbuild:prod": "npm run hash",
    "hash": "hashmark **/{main,style}.* -d md5 -l 8 --cwd dist {dir}/{name}.{hash}{ext} | replaceinfiles -S -s 'dist/*.html'",
    "posthash": "rimraf dist/js/main.js dist/css/style.css",
    "release": "gh-pages -d dist -b live -m 'release updates'",
    "preserver": "npm run build:dev",
    "server": "browser-sync start --server -f dist --ss dist --port 8080 --no-open --no-ui",
    "watch:assets": "onchange 'src/assets/**/*' -- npm run copy:assets",
    "watch:html": "onchange 'src/**/*.pug' 'src/**/*.yml' -- npm run html",
    "watch:css": "onchange 'src/**/*.styl' -- npm run css",
    "watch:js": "onchange 'src/**/*.js' -- npm run js:dev",
    "watch": "run-p watch:*",
    "functions:dev": "wrangler pages dev public --compatibility-date=2026-08-26 --compatibility-flags=nodejs_compat",
    "functions:deploy": "wrangler pages deploy public --project-name=littl31-api"
  },
  "dependencies": {
    "locomotive-scroll": "^4.0.6",
    "snapsvg": "^0.5.1",
    "stripe": "^22.5.0",
    "tailwindcss": "^2.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.12.10",
    "@babel/preset-env": "^7.12.10",
    "autoprefixer": "^10.1.0",
    "babelify": "^10.0.0",
    "browser-sync": "^3.0.4",
    "browserify": "^17.0.0",
    "cpr": "^3.0.1",
    "cross-env": "^10.1.0",
    "cssnano": "^8.0.8",
    "gh-pages": "^6.3.0",
    "hashmark": "^5.0.0",
    "js-yaml": "^5.4.1",
    "mkdirp": "^3.0.1",
    "npm-run-all": "^4.1.5",
    "onchange": "^7.1.0",
    "postcss": "^8.2.1",
    "postcss-cli": "^8.3.1",
    "pug": "^3.0.0",
    "pug-cli": "^1.0.0-alpha6",
    "replaceinfiles": "^1.1.4",
    "rimraf": "^6.1.3",
    "stylus": "^0.64.0",
    "wrangler": "^4.127.1"
  },
  "overrides": {
    "pug-cli": {
      "pug": "^3.0.4"
    },
    "immutable": "^4.3.9"
  }
}
