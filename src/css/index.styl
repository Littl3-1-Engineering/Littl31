@tailwind base;
@tailwind components;
@tailwind utilities;

@import 'locomotive-scroll/dist/locomotive-scroll.css'
@import './snap-logo.styl'
@import './font.styl'
@import './pricing.styl'
@import './theme.styl'
@import './timeline.styl'

body
	background #0A0D13

// No `overflow: hidden` here on purpose: locomotive-scroll.css (imported
// above) already scopes it to `html.has-scroll-smooth body` -- the class
// Locomotive only adds when its transform-driven smooth engine actually
// initializes (desktop, see parallax.js). An unconditional rule here would
// block native scroll on mobile/tablet, which fall back to Locomotive's
// native-scroll mode and need body's overflow left alone or nothing below
// the fold is reachable.
