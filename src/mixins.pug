//- Shared page chrome: nav, splash hero, the glass-panel "intro hero"
//- pattern, the full-bleed product/project card pattern, and the footer.
//-
//- Colon-bearing Tailwind variants (md:, hover:, group-hover:, focus:)
//- must always go inside a class='...' attribute string, never chained
//- as .md:foo — Pug's parser reads the colon as filter syntax and breaks.

mixin navBar(nav, brand)
  nav.nav-glass(class='fixed top-0 left-0 right-0 z-50')
    .max-w-screen-lg.mx-auto.flex.items-center.justify-between(class='px-4 md:px-8 py-3')
      a.flex.items-center.gap-2(href='index.html')
        img(src=brand.logo, alt=brand.name, class='w-7 h-7')
        span.font-display.text-white(class='text-lg tracking-wide')= brand.name
      button.text-white(type='button', aria-label='Toggle menu', aria-expanded='false', data-nav-toggle, class='md:hidden p-2')
        svg(fill='none', viewBox='0 0 24 24', stroke='currentColor', class='w-6 h-6')
          path(stroke-linecap='round', stroke-linejoin='round', stroke-width='2', d='M4 6h16M4 12h16M4 18h16')
      ul.font-mono(data-nav-menu, class='hidden md:flex items-center gap-8 text-xs uppercase tracking-widest')
        for link in nav
          li
            a.text-gray-300.transition-colors(href=link.href)= link.text

mixin splash
  section#splash.h-screen.flex.flex-col.items-center.justify-center(data-scroll-section)
    div(
      data-scroll,
      data-scroll-repeat,
      data-scroll-speed='-3',
      data-scroll-position='top',
    )
      svg.logo.-mt-32
    div(
      data-scroll,
      data-scroll-repeat,
      data-scroll-speed='-2',
      data-scroll-position='top',
    )
      a(href='#intro')
        h1.font-bold.font-display.accent-text-orange(class='text-5xl', data-scramble-title) &nbsp;
    if block
      block

mixin introHero(item, accent, asH1)
  section#intro(data-scroll-section, class='p-8 flex items-center justify-center')
    .max-w-screen-lg.w-full.relative(class=`window-frame accent-${accent}`)
      .window-tab
      .window-body
        .window-titlebar
          span.window-dot
        .window-content(class='p-8 md:p-12')
          #{asH1 ? 'h1' : 'h2'}.font-display.font-bold.text-right(
            data-scramble-intro,
            data-scroll,
            data-scroll-repeat,
            data-scroll-speed='3',
            data-scroll-position='top',
            data-scroll-direction='horizontal',
            class=`accent-text-${accent} text-4xl md:text-6xl`
          )= item.title
          .w-full.mt-12.flex.justify-end
            div.max-w-xl.space-y-6(data-scroll)
              if item.lead
                p.opacity-0(
                  data-scroll,
                  data-scroll-repeat,
                  data-scroll-class='opacity-100',
                  class='transition-opacity delay-100 duration-700 text-gray-300 leading-relaxed'
                )= item.lead
              if item.bullets
                ul.opacity-0(
                  data-scroll,
                  data-scroll-repeat,
                  data-scroll-class='opacity-100',
                  class='transition-opacity delay-100 duration-700 text-gray-300 text-sm md:text-base leading-relaxed list-disc list-inside space-y-2'
                )
                  for bullet in item.bullets
                    li= bullet
              for line in item.lines
                p.opacity-0(
                  data-scroll,
                  data-scroll-repeat,
                  data-scroll-class='opacity-100',
                  class='transition-opacity delay-100 duration-700 text-gray-300 leading-relaxed'
                )= line
              if item.cta
                p.pt-2
                  a(href=item.cta.href, class=`btn-glow accent-${accent}`)= item.cta.text

mixin section(item, defaultAccent)
  - var accent = item.accent || defaultAccent || 'amber'
  .flex.items-center.justify-center(id=item.id, class='p-4 md:p-8')
    .max-w-screen-lg.w-full.relative(class=`window-frame accent-${accent}`)
      .window-tab
      .window-body
        .window-titlebar
          span.window-dot
          if item.eyebrow
            span.font-mono(class='text-xs uppercase tracking-widest text-gray-300')= item.eyebrow
        .window-content(class='p-8 md:p-12')
          h2.font-display.font-bold(
            data-scroll,
            data-scroll-repeat,
            data-scroll-speed='-1',
            data-scroll-position='top',
            data-scroll-direction='horizontal',
            data-scroll-target=`#${item.id}`,
            class=`accent-text-${accent} text-4xl md:text-6xl`
          )= item.title
          hr.my-4(class=`accent-border-${accent} border-t-2 opacity-40`)

          if item.quip
            p.font-mono.italic(class=`accent-text-${accent} text-xs md:text-sm opacity-80`)
              | “#{item.quip}”

          if item.badge
            - var badgeAccent = item.badge.accent || 'gray'
            span.inline-block.mt-2(class=`accent-border-${badgeAccent} accent-text-${badgeAccent} text-xs tracking-widest uppercase border rounded-full px-4 py-2`)= item.badge.text

          - var mediaSide = item.right ? 'justify-start' : 'justify-end'
          - var textSide = item.right ? 'justify-end' : 'justify-start'
          - var textWidth = item.wide ? 'max-w-2xl' : 'max-w-md'

          if item.img
            .w-full.mt-12.flex.flex-col(class=`gap-8 md:items-start md:flex-row ${item.right ? 'md:flex-row-reverse' : ''}`)
              div(class='w-full md:w-1/2')
                .overflow-hidden(class=`accent-border-${accent} border rounded-lg w-full`)
                  img.w-full(src=item.img, alt=item.imgAlt || item.imgCaption || item.title, loading='lazy')
                if item.imgCaption
                  p.font-mono.text-gray-500.mt-3(class='text-xs leading-relaxed')= item.imgCaption
              div(class='w-full md:w-1/2 space-y-6')
                for line in item.lines
                  p.opacity-0(
                    data-scroll,
                    data-scroll-repeat,
                    data-scroll-class='opacity-100',
                    class='transition-opacity delay-100 duration-700 text-gray-300 leading-relaxed'
                  )= line
          else
            if item.vid
              .w-full.mt-12.flex(class=mediaSide)
                .overflow-hidden(class=`accent-border-${accent} border rounded-lg w-full md:w-1/2`)
                  video.w-full(autoplay, loop, muted, playsinline)
                    source(src=item.vid, type='video/mp4')

            .w-full.mt-10.flex(class=textSide)
              div(class=`${textWidth} space-y-6`)
                for line in item.lines
                  p.opacity-0(
                    data-scroll,
                    data-scroll-repeat,
                    data-scroll-class='opacity-100',
                    class='transition-opacity delay-100 duration-700 text-gray-300 leading-relaxed'
                  )= line

          if item.pricing
            .flex.flex-wrap.pt-6(class='gap-6')
              for tier in item.pricing
                - var tierAccent = tier.accent || accent
                .group.relative
                  if tier.badge
                    span.absolute.whitespace-nowrap(class=`accent-border-${tierAccent} accent-text-${tierAccent} text-xs tracking-widest uppercase border rounded-full px-3 py-1 bg-gray-900`, style='top: -0.85rem; left: 50%; transform: translateX(-50%); z-index: 10;')= tier.badge
                  .window-frame.window-sm(class=`accent-${tierAccent}`)
                    .window-body
                      .window-content(class='px-6 py-4')
                        .flex.items-center.gap-2
                          if tier.amounts
                            .flex.items-center(class=`accent-text-${tierAccent} gap-1.5`)
                              if tier.scrip
                                svg.scrip-symbol(
                                  data-scrip-symbol,
                                  viewBox='0 0 40 65',
                                  width='16',
                                  height='26',
                                  fill='currentColor',
                                  class='opacity-0 transition-opacity duration-200',
                                  aria-hidden='true'
                                )
                                  rect(x='6', y='0', width='28', height='6')
                                  rect(x='-4', y='22', width='48', height='6')
                                  rect(x='6', y='59', width='28', height='6')
                                  rect(x='34', y='6', width='6', height='19')
                                  rect(x='34', y='28', width='6', height='31')
                              div.font-bold(
                                class=`accent-text-${tierAccent} text-3xl`,
                                tabindex='0',
                                role='button',
                                data-price-toggle,
                                data-amount-usd=tier.amounts.USD,
                                data-amount-cad=tier.amounts.CAD,
                                data-amount-eur=tier.amounts.EUR,
                                data-scrip-price=tier.scrip,
                                aria-label=`${tier.amounts.USD} — switch currency above, or hover/tap for Alfr3d Scrip`
                              )= tier.amounts.USD
                          else
                            div.font-bold(class=`accent-text-${tierAccent} text-3xl`)= tier.amount
                          if tier.info
                            button(
                              type='button',
                              aria-label=`More info — ${tier.label}`,
                              data-pricing-info-toggle,
                              class='flex-shrink-0 w-5 h-5 rounded-full border border-gray-500 text-gray-400 text-xs italic font-bold leading-none flex items-center justify-center hover:border-amber-400 hover:text-amber-400 focus:outline-none focus:border-amber-400 focus:text-amber-400 transition-colors'
                            ) i
                        div.text-xs.text-gray-400.mt-1= tier.label
                        if tier.cta
                          p.mt-3
                            a.text-xs(href=tier.cta.href, class=`btn-glow accent-${tierAccent}`, style='padding: 0.4rem 1rem;')= tier.cta.text
                        if tier.note
                          p.text-xs.text-gray-500.mt-2.italic= tier.note
                  if tier.info
                    .pricing-info-popover(
                      data-pricing-info-popover,
                      class=`info-popover accent-border-${tierAccent} absolute left-0 top-full mt-2 w-72 p-4 border text-sm text-gray-300 leading-relaxed opacity-0 pointer-events-none transition-opacity duration-200 z-20 group-hover:opacity-100 group-hover:pointer-events-auto`
                    )= tier.info

          if item.cta
            p.pt-2
              a(href=item.cta.href, class=`btn-glow accent-${accent}`)= item.cta.text

mixin siteFooter(data, backLink)
  footer.nav-glass.text-white(id='contact', data-scroll-section, class='py-8 px-4')
    .max-w-screen-lg.mx-auto.flex.flex-col
      if backLink
        .w-full.mb-8
          a.text-gray-400.transition-colors(href=backLink.href, class='text-sm hover:text-amber-400')= backLink.text
      .flex.items-center.w-full
        div(class='w-1/3')
        div(class='w-1/3')
          img.mx-auto(src='assets/images/logo.svg', alt='', class='w-24')
        div.text-right(class='w-1/3')
          div(
            data-scroll,
            data-scroll-repeat,
            data-scroll-position='top',
            data-scroll-speed='-1'
          )
          - var mail = `${data.email}`
          a.cursor-pointer.font-bold.font-display.accent-text-orange(
            href='mailto:' + mail,
            data-scramble-contact,
            class='text-5xl'
          ) Contact
      p.text-center.text-gray-400(
        data-scroll,
        data-scroll-repeat,
        data-scroll-speed='0.5',
        class='text-sm mt-4 px-8'
      )= data.text
      p.text-center.mt-2
        a.text-gray-500.transition-colors(href='privacy.html', class='text-xs hover:text-amber-400') Privacy Policy
        span.text-gray-600(class='text-xs mx-2') ·
        a.text-gray-500.transition-colors(href='terms.html', class='text-xs hover:text-amber-400') Terms of Service

//- SEO head block: title, description, canonical, robots, Open Graph,
//- Twitter card, and JSON-LD. `path` is the extensionless public path
//- ('' for home) — it must match the entry in scripts/sitemap.js.
mixin seoHead(m, path, ld)
  - var origin = 'https://www.littl31.com'
  - var url = origin + '/' + path
  - var image = origin + '/assets/images/alfr3d-dashboard.jpg'
  title #{m.title}
  meta(name='description' content=m.description)
  link(rel='canonical' href=url)
  meta(name='robots' content='index, follow, max-image-preview:large')
  meta(name='theme-color' content='#000000')
  meta(property='og:site_name' content='Littl3.1 Engineering')
  meta(property='og:type' content='website')
  meta(property='og:locale' content='en_US')
  meta(property='og:title' content=m.title)
  meta(property='og:description' content=m.description)
  meta(property='og:url' content=url)
  meta(property='og:image' content=image)
  meta(property='og:image:width' content='1400')
  meta(property='og:image:height' content='693')
  meta(property='og:image:alt' content='The ALFR3D dashboard')
  meta(name='twitter:card' content='summary_large_image')
  meta(name='twitter:title' content=m.title)
  meta(name='twitter:description' content=m.description)
  meta(name='twitter:image' content=image)
  - var graph = [{ '@type': 'WebPage', '@id': url + '#webpage', url: url, name: m.title, description: m.description, isPartOf: { '@id': origin + '/#website' }, inLanguage: 'en' }]
  if path === ''
    - graph.push({ '@type': 'Organization', '@id': origin + '/#org', name: 'Littl3.1 Engineering', url: origin + '/', logo: origin + '/assets/images/logo.svg', email: 'athos@littl31.com', sameAs: ['https://github.com/Littl3-1-Engineering'] })
    - graph.push({ '@type': 'WebSite', '@id': origin + '/#website', url: origin + '/', name: 'Littl3.1 Engineering', publisher: { '@id': origin + '/#org' }, inLanguage: 'en' })
  if path === 'alfr3d'
    - graph.push({ '@type': 'SoftwareApplication', name: 'ALFR3D', applicationCategory: 'HomeAutomationApplication', operatingSystem: 'Linux, Android', description: m.description, url: url, image: image, license: 'https://fsl.software/', publisher: { '@id': origin + '/#org' } })
  script(type='application/ld+json')!= JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c')
